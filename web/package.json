{
  "name": "veyra-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:desktop": "vite --config vite.desktop.config.ts --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --config vite.desktop.config.ts",
    "check:bundle": "node scripts/check-bundle-freshness.mjs",
    "test:status-tone": "node scripts/status-tone-check.mjs",
    "test:product-contract": "node scripts/product-contract-check.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.555.0",
    "vite": "^7.2.2",
    "typescript": "^5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
