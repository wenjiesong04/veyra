# Veyra local-first configuration.
# Copy this file to .env and fill only the values you actually use.
# Keep .env private. It may contain local tokens, app credentials, and paths.

# Runtime paths
VEYRA_STATE_ROOT=state
VEYRA_AGENCY_ROOT=agency
VEYRA_ACTION_RECORD_RETENTION_LIMIT=10000

# API server
VEYRA_HOST=127.0.0.1
VEYRA_PORT=8000
# Keep empty for loopback-only use. Set a strong token before binding VEYRA_HOST
# to any non-loopback address.
VEYRA_LOCAL_API_TOKEN=
# Required read-only token when Project Guardian GitHub Actions polling is used.
# Use fine-grained Metadata, Actions, and Checks read access.
VEYRA_GITHUB_TOKEN=
# Enabling a public Feishu callback also requires FEISHU_VERIFICATION_TOKEN.
# Keep disabled for the recommended WebSocket/local-only setup.
VEYRA_ALLOW_PUBLIC_PROVIDER_CALLBACKS=0
VEYRA_ACTIVE_LOOP_AUTOSTART=1
VEYRA_FEISHU_WS_AUTOSTART=1

# Core model, OpenAI-compatible.
# Examples:
#   VEYRA_CORE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
#   VEYRA_CORE_MODEL_BASE_URL=https://api.openai.com/v1
#   VEYRA_CORE_MODEL_BASE_URL=https://api.moonshot.cn/v1
VEYRA_CORE_MODEL_ENABLED=0
VEYRA_CORE_MODEL_PROVIDER=openai_compatible
VEYRA_CORE_MODEL_BASE_URL=
VEYRA_CORE_MODEL=
VEYRA_CORE_MODEL_API_KEY_ENV=VEYRA_CORE_MODEL_API_KEY
VEYRA_CORE_MODEL_API_KEY=
VEYRA_CORE_MODEL_DECISION_MODE=auto
VEYRA_CORE_MODEL_MAX_TOKENS=700

# Selected local Agent runtime. OpenClaw is the default.
VEYRA_SELECTED_AGENT=openclaw
VEYRA_OPENCLAW_VERSION=2026.6.11
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_SCOPES=operator.read,operator.write
OPENCLAW_MEMORY_SCOPES=operator.read,operator.write,operator.admin
VEYRA_OPENCLAW_USE_LOCAL_CONFIG=1
VEYRA_OPENCLAW_WORKSPACE_MEMORY_FALLBACK=1

# Optional HTTP Agent runtimes. Leave blank for v1 local personal use.
HERMES_BASE_URL=
HERMES_API_KEY=
CUSTOM_AGENT_BASE_URL=
CUSTOM_AGENT_API_KEY=

# Feishu local integration. Leave blank until you create your own Feishu app.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_ACCESS_TOKEN=
FEISHU_DEFAULT_RECEIVE_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Optional outbound webhook and tool executors.
VEYRA_CHANNEL_WEBHOOK_URL=
VEYRA_ALERT_WEBHOOK_URL=
VEYRA_TOOL_PROXY_BROWSER_ENABLED=0
VEYRA_TOOL_PROXY_BROWSER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
VEYRA_TOOL_PROXY_API_ENABLED=0
VEYRA_TOOL_PROXY_API_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional probes and recovery hooks.
VEYRA_SEARCH_PROVIDER=auto
VEYRA_YOUTUBE_CHANNEL_MAP=
VEYRA_APP_LOG=
VEYRA_AGENT_RESTART_CMD=
